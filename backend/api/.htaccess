Options -Indexes
RewriteEngine On

# Handle preflight OPTIONS
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=200,L]

# Block config and db files from direct access
RewriteRule ^(config|db)\.php$ - [F,L]

# Clean URL routing: /api/movies → movies.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z_]+)/?$ $1.php [QSA,L]
